<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <!-- 与仓库 vendored s4pi 一致: .NET Framework 4.0. 仅在 Windows 端用 msbuild 编译.
         默认 Debug (勿用 Release): 上游 s4pi PreBuildEvent 硬编码 bin\Debug. -->
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SidecarBuilder</RootNamespace>
    <AssemblyName>SidecarBuilder</AssemblyName>
    <ProjectGuid>{3F7A1C2E-9B4D-4E8A-A9C0-11D25F6E8B42}</ProjectGuid>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <!-- MSB3644 修复 (不装旧 .NET 4.0 Developer Pack): 通过 NuGet 官方包
       Microsoft.NETFramework.ReferenceAssemblies 自包含 net40 reference assemblies。
       仅 Windows 端执行 restore -> build。
       该包在 build 时设置 FrameworkPathOverride 到包内 net40 ref 目录,
       该全局属性会沿 ProjectReference 传递给 s4pi 工程, 一并解决它们的 MSB3644。
       保持 TargetFrameworkVersion=v4.0, 不 retarget 到 4.8。
       RestoreProjectStyle=PackageReference: 让现代 msbuild 对旧式 csproj 走
       PackageReference restore (而非 packages.config 模式), 否则 restore 会失败。 -->
  <PropertyGroup>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>
  <!-- 引用仓库内 vendor 的 s4pi 源码工程 (可复现依赖, 见 vendor/s4pi/README-S4PI-VENDOR.md);
       msbuild 会自动按依赖图一并编译. 序列化逻辑完全由 s4pi 负责. -->
  <!-- 关键: s4pi 的 CS System Classes / Settings 工程 PreBuildEvent 会调用
       $(SolutionDir)s4pi\CreateAssemblyVersion\bin\Debug\CreateAssemblyVersion。
       直接 msbuild 本 csproj 时 (无 .sln) SolutionDir 默认未定义, 故在此把
       SolutionDir 指向 vendor 根 (带尾部反斜杠), 使硬编码后缀 s4pi\... 对齐
       到 vendor\s4pi\... 目录 (编译期工具可被找到)。 -->
  <PropertyGroup>
    <SolutionDir>$(MSBuildThisFileDirectory)..\vendor\</SolutionDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\vendor\CS System Classes\CS System Classes.csproj">
      <Project>{00200E76-C245-42A7-B567-5C30EDBCE977}</Project>
      <Name>System.Custom</Name>
    </ProjectReference>
    <ProjectReference Include="..\vendor\s4pi\Interfaces\Interfaces.csproj">
      <Project>{51023BD2-9139-438D-B794-95E5EC023537}</Project>
      <Name>s4pi.Interfaces</Name>
    </ProjectReference>
    <ProjectReference Include="..\vendor\s4pi\Settings\Settings.csproj">
      <Project>{374F37CF-1F27-4613-96FD-9B956A3D82B1}</Project>
      <Name>s4pi.Settings</Name>
    </ProjectReference>
    <ProjectReference Include="..\vendor\s4pi\Package\Package.csproj">
      <Project>{9D8BB6F7-373E-4FBC-B5E8-9709B4CE9A37}</Project>
      <Name>s4pi.Package</Name>
    </ProjectReference>
    <ProjectReference Include="..\vendor\s4pi Wrappers\StblResource\StblResource.csproj">
      <Project>{672D72EC-89DA-4EF3-88CC-BEEC5BA478B2}</Project>
      <Name>s4pi.StblResource</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
